# Xandeum pRPC seed IPs (comma-separated)
# These are queried server-side by /api/pnodes to discover pNodes from gossip.
# If unset, defaults to the official seed list.
#
# Example:
# XANDEUM_PRPC_SEEDS=173.212.220.65,161.97.97.41
XANDEUM_PRPC_SEEDS=

# Optional timeout (ms) can also be passed as query param to /api/pnodes?timeoutMs=5000
# XANDEUM_PRPC_TIMEOUT_MS=5000
